{
  "opencollection": "1.0.0",
  "info": {
    "name": "Adobe Creative Cloud Creative Cloud Libraries Assets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Adobe Creative Cloud Upload Asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cc-libraries.adobe.io/api/v1/assets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an upload URI for uploading a document asset. Returns a presigned URL for uploading the file content and an asset ID for referencing in subsequent operations."
        },
        {
          "info": {
            "name": "Adobe Creative Cloud Get Asset Download URI",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cc-libraries.adobe.io/api/v1/assets/:assetID",
            "params": [
              {
                "name": "assetID",
                "value": "abc123def456",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a presigned download URL for a processed asset."
        },
        {
          "info": {
            "name": "Adobe Creative Cloud Delete Asset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cc-libraries.adobe.io/api/v1/assets/:assetID",
            "params": [
              {
                "name": "assetID",
                "value": "abc123def456",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a document asset from temporary storage."
        }
      ]
    }
  ],
  "bundled": true
}