          "docs": "Creates a PDF from supported file formats including Word, Excel, PowerPoint, and image files."
        },
        {
          "info": {
            "name": "Adobe Creative Cloud Export PDF",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cc-libraries.adobe.io/api/v1/operation/exportpdf",
            "body": {
              "type": "json",
              "data": "{}"
